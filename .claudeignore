# Build output — never changes unless you run a build, not source of truth
frontend/dist/

# Dependencies — never edit these directly
frontend/node_modules/

# Lock files — read-only, npm manages these
frontend/package-lock.json

# Static assets — binary files, no logic to search
frontend/public/
frontend/favicon/
frontend/src/assets/

# Legacy / archived code — not in use
docs/legacy-backend/

# Test snapshots / vitest cache
frontend/.vitest/
frontend/coverage/

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
